# Byte-compiled / optimized / Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments & local configuration
.venv/
.venv-*/
*.egg-info/
.env
.env.*
!.env.example

# OS metadata
.DS_Store
.DS_Store?
._*

# Data directories
data/raw/**
data/interim/**
data/processed/**
data/deleted/**
data/external/**

# Artifacts, models & encoder caches
artifacts/models/**
artifacts/encoders/**
artifacts/jobs/**

# Frontend dependencies & build output
frontend/node_modules/
frontend/dist/

# Preserve directory structure via .gitkeep
!**/.gitkeep

# Local Python runtime and tool cache
.runtime/
frontend/.npm-cache/
artifacts/reports/*-server*.log
artifacts/reports/local-server.pid
artifacts/reports/*.tmp

# Local user scenarios, observations, and uploaded source snapshots
artifacts/observatory.sqlite3*
artifacts/archive-snapshots/

# Excluded architecture page and WhatsApp images
architecture-page-*.jpg
architecture-page-*.jpeg
architecture-page-*.png
*[Ww]hats[Aa]pp*


artifacts/observatory-graphs/
